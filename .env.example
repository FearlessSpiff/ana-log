# OAuth client from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of the app (used for links in the PocketBase admin UI)
APP_URL=https://ana-log.example.com

# Comma separated Google accounts allowed to sign in. Leave empty to allow anyone.
ALLOWED_EMAILS=

# Host port nginx proxies to (container always listens on 8090)
ANA_LOG_PORT=8090
